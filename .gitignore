# Personal career data and generated application material must stay local.
profile/*
!profile/README.md
jobs/inbox/*
!jobs/inbox/.gitkeep
jobs/approved/*
!jobs/approved/.gitkeep
applications/*
!applications/.gitkeep
tmp/
*.pdf
*.docx
*.xlsx
*.png
*.jpg
!.agents/assets/**
__pycache__/
tools/browser-application/node_modules/
tools/browser-application/dist/
tools/browser-application/.local/
!tools/browser-application/extension/icons/*.png

# Local build artefacts, job-crawl outputs and accidental Windows-path expansions.
# These can contain private job data, browser state, or large dependency caches.
node_modules/
scripts/node_modules/
output/
outputs/
.tmp/
undefined/
%SystemDrive%/
