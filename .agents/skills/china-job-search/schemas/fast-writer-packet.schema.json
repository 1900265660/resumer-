{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fast-writer-packet.schema.json",
  "title": "Single-pass fast writer packet",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "content_pipeline", "company", "target_role", "role_family", "context", "content_sha256", "supported_coverage_gaps", "rules"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "content_pipeline": {"const": "fast-assemble"},
    "company": {"type": "string", "minLength": 1},
    "target_role": {"type": "string", "minLength": 1},
    "role_family": {"type": "string", "minLength": 1},
    "context": {"enum": ["game", "non_game"]},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "supported_coverage_gaps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requirement_id", "requirement_text", "allowed_facts"],
        "properties": {
          "requirement_id": {"type": "string", "minLength": 1},
          "requirement_text": {"type": "string", "minLength": 1},
          "allowed_facts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["fact_id", "text"],
              "properties": {
                "fact_id": {"type": "string", "pattern": "^FACT-"},
                "text": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_writer_calls", "new_facts_forbidden", "rewrite_existing_bullets_forbidden", "non_game_game_content_forbidden"],
      "properties": {
        "max_writer_calls": {"const": 1},
        "new_facts_forbidden": {"const": true},
        "rewrite_existing_bullets_forbidden": {"const": true},
        "non_game_game_content_forbidden": {"type": "boolean"}
      }
    }
  }
}
