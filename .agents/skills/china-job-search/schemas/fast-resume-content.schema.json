{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fast-resume-content.schema.json",
  "title": "Fast assembled resume content",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "content_pipeline", "company", "target_role", "role_family", "context", "contact", "source_hashes", "sections", "covered_requirement_ids", "fact_gaps", "supported_coverage_gaps", "writer_additions"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "content_pipeline": {"const": "fast-assemble"},
    "company": {"type": "string", "minLength": 1},
    "target_role": {"type": "string", "minLength": 1},
    "role_family": {"type": "string", "minLength": 1},
    "role_track": {"type": ["string", "null"]},
    "context": {"enum": ["game", "non_game"]},
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "phone", "email", "location"],
      "properties": {
        "name": {"type": "string"}, "phone": {"type": "string"}, "email": {"type": "string"}, "location": {"type": "string"}
      }
    },
    "source_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_sha256", "claims_sha256", "jd_sha256", "selection_sha256"],
      "properties": {
        "profile_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "claims_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "jd_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "selection_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "sections": {"type": "array", "items": {"$ref": "#/$defs/section"}},
    "covered_requirement_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "fact_gaps": {"type": "array", "items": {"$ref": "#/$defs/gap"}},
    "supported_coverage_gaps": {"type": "array", "items": {"$ref": "#/$defs/gap"}},
    "writer_additions": {"type": "array", "items": {"$ref": "#/$defs/bullet"}}
  },
  "$defs": {
    "bullet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "experience_id", "fact_ids", "requirement_ids", "claim_id", "capability_tags"],
      "properties": {
        "text": {"type": "string", "minLength": 1},
        "experience_id": {"type": "string", "minLength": 1},
        "fact_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^FACT-"}},
        "requirement_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "claim_id": {"type": ["string", "null"]},
        "capability_tags": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "heading": {"type": "string", "minLength": 1}
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["experience_id", "heading", "bullets"],
      "properties": {
        "experience_id": {"type": "string"}, "heading": {"type": "string"}, "bullets": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/bullet"}}
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "entries"],
      "properties": {"name": {"type": "string"}, "entries": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/entry"}}}
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirement_id", "text", "fact_ids"],
      "properties": {"requirement_id": {"type": "string"}, "text": {"type": "string"}, "fact_ids": {"type": "array", "items": {"type": "string"}}}
    }
  }
}
