{
  "$defs": {
    "IdealEvidenceItem": {
      "additionalProperties": false,
      "properties": {
        "requirement_id": {
          "pattern": "^REQ-[0-9]{3}$",
          "title": "Requirement Id",
          "type": "string"
        },
        "evidence_description": {
          "minLength": 1,
          "title": "Evidence Description",
          "type": "string"
        },
        "candidate_specific": {
          "const": false,
          "default": false,
          "title": "Candidate Specific",
          "type": "boolean"
        }
      },
      "required": [
        "requirement_id",
        "evidence_description"
      ],
      "title": "IdealEvidenceItem",
      "type": "object"
    },
    "JobRequirement": {
      "additionalProperties": false,
      "properties": {
        "requirement_id": {
          "pattern": "^REQ-[0-9]{3}$",
          "title": "Requirement Id",
          "type": "string"
        },
        "title": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "priority": {
          "$ref": "#/$defs/RequirementPriority"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "keywords": {
          "items": {
            "type": "string"
          },
          "title": "Keywords",
          "type": "array"
        }
      },
      "required": [
        "requirement_id",
        "title",
        "description",
        "priority",
        "rationale"
      ],
      "title": "JobRequirement",
      "type": "object"
    },
    "RequirementPriority": {
      "enum": [
        "must",
        "should",
        "nice_to_have"
      ],
      "title": "RequirementPriority",
      "type": "string"
    },
    "RoleFamily": {
      "enum": [
        "ai_product_manager",
        "game_production_pm",
        "community_operations",
        "community_product_manager",
        "game_designer"
      ],
      "title": "RoleFamily",
      "type": "string"
    },
    "RoleTrack": {
      "enum": [
        "community",
        "content",
        "growth",
        "integrated",
        "system",
        "combat",
        "writing",
        "narrative",
        "general"
      ],
      "title": "RoleTrack",
      "type": "string"
    },
    "SourceDigests": {
      "additionalProperties": false,
      "properties": {
        "jd_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Jd Sha256",
          "type": "string"
        },
        "fact_snapshot_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Fact Snapshot Sha256",
          "type": "string"
        },
        "preferences_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Preferences Sha256",
          "type": "string"
        },
        "reference_cards_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference Cards Sha256"
        }
      },
      "required": [
        "jd_sha256",
        "fact_snapshot_sha256",
        "preferences_sha256"
      ],
      "title": "SourceDigests",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "1.5",
      "enum": [
        "1.0",
        "1.1",
        "1.2",
        "1.3",
        "1.4",
        "1.5"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "run_id": {
      "pattern": "^cr_[0-9]{8}T[0-9]{6}_[a-z0-9]{6}$",
      "title": "Run Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "source_digests": {
      "$ref": "#/$defs/SourceDigests"
    },
    "role_family": {
      "$ref": "#/$defs/RoleFamily",
      "default": "ai_product_manager"
    },
    "role_track": {
      "anyOf": [
        {
          "$ref": "#/$defs/RoleTrack"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "job_goal": {
      "minLength": 1,
      "title": "Job Goal",
      "type": "string"
    },
    "business_problems": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Business Problems",
      "type": "array"
    },
    "requirements": {
      "items": {
        "$ref": "#/$defs/JobRequirement"
      },
      "minItems": 1,
      "title": "Requirements",
      "type": "array"
    },
    "ideal_evidence_blueprint": {
      "items": {
        "$ref": "#/$defs/IdealEvidenceItem"
      },
      "title": "Ideal Evidence Blueprint",
      "type": "array"
    },
    "risks": {
      "items": {
        "type": "string"
      },
      "title": "Risks",
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "created_at",
    "source_digests",
    "job_goal",
    "business_problems",
    "requirements"
  ],
  "title": "JDAnalysisArtifact",
  "type": "object"
}
