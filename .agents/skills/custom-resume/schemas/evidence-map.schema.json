{
  "$defs": {
    "CoverageLevel": {
      "enum": [
        "direct",
        "composite",
        "accepted_estimate",
        "candidate",
        "unsupported"
      ],
      "title": "CoverageLevel",
      "type": "string"
    },
    "EvidenceMapping": {
      "additionalProperties": false,
      "properties": {
        "requirement_id": {
          "pattern": "^REQ-[0-9]{3}$",
          "title": "Requirement Id",
          "type": "string"
        },
        "coverage": {
          "$ref": "#/$defs/CoverageLevel"
        },
        "fact_ids": {
          "items": {
            "pattern": "^FACT-[A-Z]+-[0-9]{3}-[0-9]{2}$",
            "type": "string"
          },
          "title": "Fact Ids",
          "type": "array"
        },
        "selected": {
          "default": false,
          "title": "Selected",
          "type": "boolean"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "gap_summary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gap Summary"
        }
      },
      "required": [
        "requirement_id",
        "coverage",
        "rationale"
      ],
      "title": "EvidenceMapping",
      "type": "object"
    },
    "SourceDigests": {
      "additionalProperties": false,
      "properties": {
        "jd_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Jd Sha256",
          "type": "string"
        },
        "fact_snapshot_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Fact Snapshot Sha256",
          "type": "string"
        },
        "preferences_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Preferences Sha256",
          "type": "string"
        },
        "reference_cards_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference Cards Sha256"
        }
      },
      "required": [
        "jd_sha256",
        "fact_snapshot_sha256",
        "preferences_sha256"
      ],
      "title": "SourceDigests",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "1.5",
      "enum": [
        "1.0",
        "1.1",
        "1.2",
        "1.3",
        "1.4",
        "1.5"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "run_id": {
      "pattern": "^cr_[0-9]{8}T[0-9]{6}_[a-z0-9]{6}$",
      "title": "Run Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "source_digests": {
      "$ref": "#/$defs/SourceDigests"
    },
    "mappings": {
      "items": {
        "$ref": "#/$defs/EvidenceMapping"
      },
      "minItems": 1,
      "title": "Mappings",
      "type": "array"
    },
    "selection_approved": {
      "default": false,
      "title": "Selection Approved",
      "type": "boolean"
    },
    "approved_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Approved At"
    }
  },
  "required": [
    "run_id",
    "created_at",
    "source_digests",
    "mappings"
  ],
  "title": "EvidenceMapArtifact",
  "type": "object"
}
