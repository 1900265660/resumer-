{
  "$defs": {
    "SourceDigests": {
      "additionalProperties": false,
      "properties": {
        "jd_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Jd Sha256",
          "type": "string"
        },
        "fact_snapshot_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Fact Snapshot Sha256",
          "type": "string"
        },
        "preferences_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Preferences Sha256",
          "type": "string"
        },
        "reference_cards_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference Cards Sha256"
        }
      },
      "required": [
        "jd_sha256",
        "fact_snapshot_sha256",
        "preferences_sha256"
      ],
      "title": "SourceDigests",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "1.5",
      "enum": [
        "1.0",
        "1.1",
        "1.2",
        "1.3",
        "1.4",
        "1.5"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "run_id": {
      "pattern": "^cr_[0-9]{8}T[0-9]{6}_[a-z0-9]{6}$",
      "title": "Run Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "source_digests": {
      "$ref": "#/$defs/SourceDigests"
    },
    "selection_approval_id": {
      "pattern": "^selection_approval_[a-f0-9]{32}$",
      "title": "Selection Approval Id",
      "type": "string"
    },
    "experience_selection_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Experience Selection Sha256",
      "type": "string"
    },
    "story_plan_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Story Plan Sha256",
      "type": "string"
    },
    "approved_at": {
      "format": "date-time",
      "title": "Approved At",
      "type": "string"
    },
    "source": {
      "const": "explicit_user_message",
      "default": "explicit_user_message",
      "title": "Source",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "created_at",
    "source_digests",
    "selection_approval_id",
    "experience_selection_sha256",
    "story_plan_sha256",
    "approved_at"
  ],
  "title": "SelectionApprovalArtifact",
  "type": "object"
}
