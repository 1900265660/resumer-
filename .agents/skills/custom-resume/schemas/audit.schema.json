{
  "$defs": {
    "AuditDisposition": {
      "enum": [
        "passed",
        "failed",
        "needs_review"
      ],
      "title": "AuditDisposition",
      "type": "string"
    },
    "AuditFinding": {
      "additionalProperties": false,
      "properties": {
        "error_code": {
          "pattern": "^[A-Z][A-Z0-9_]+$",
          "title": "Error Code",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "artifact": {
          "minLength": 1,
          "title": "Artifact",
          "type": "string"
        },
        "field_path": {
          "minLength": 1,
          "title": "Field Path",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "error_code",
        "severity",
        "artifact",
        "field_path",
        "message"
      ],
      "title": "AuditFinding",
      "type": "object"
    },
    "QualityAudit": {
      "additionalProperties": false,
      "properties": {
        "jd_coverage": {
          "$ref": "#/$defs/QualityDimension"
        },
        "selection_quality": {
          "anyOf": [
            {
              "$ref": "#/$defs/QualityDimension"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "evidence_depth": {
          "$ref": "#/$defs/QualityDimension"
        },
        "hr_scan": {
          "$ref": "#/$defs/QualityDimension"
        },
        "language_naturalness": {
          "$ref": "#/$defs/QualityDimension"
        },
        "gap_disclosure_passed": {
          "default": true,
          "title": "Gap Disclosure Passed",
          "type": "boolean"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "override_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Override Reason"
        }
      },
      "required": [
        "jd_coverage",
        "evidence_depth",
        "hr_scan",
        "language_naturalness",
        "passed"
      ],
      "title": "QualityAudit",
      "type": "object"
    },
    "QualityDimension": {
      "additionalProperties": false,
      "properties": {
        "score": {
          "maximum": 10,
          "minimum": 0,
          "title": "Score",
          "type": "number"
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "recommendations": {
          "items": {
            "type": "string"
          },
          "title": "Recommendations",
          "type": "array"
        }
      },
      "required": [
        "score",
        "evidence"
      ],
      "title": "QualityDimension",
      "type": "object"
    },
    "RevisionRecord": {
      "additionalProperties": false,
      "properties": {
        "round": {
          "maximum": 2,
          "minimum": 1,
          "title": "Round",
          "type": "integer"
        },
        "issue_codes": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Issue Codes",
          "type": "array"
        },
        "changes": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Changes",
          "type": "array"
        }
      },
      "required": [
        "round",
        "issue_codes",
        "changes"
      ],
      "title": "RevisionRecord",
      "type": "object"
    },
    "Severity": {
      "enum": [
        "hard",
        "warning"
      ],
      "title": "Severity",
      "type": "string"
    },
    "SourceDigests": {
      "additionalProperties": false,
      "properties": {
        "jd_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Jd Sha256",
          "type": "string"
        },
        "fact_snapshot_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Fact Snapshot Sha256",
          "type": "string"
        },
        "preferences_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Preferences Sha256",
          "type": "string"
        },
        "reference_cards_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference Cards Sha256"
        }
      },
      "required": [
        "jd_sha256",
        "fact_snapshot_sha256",
        "preferences_sha256"
      ],
      "title": "SourceDigests",
      "type": "object"
    },
    "TruthAudit": {
      "additionalProperties": false,
      "properties": {
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/AuditFinding"
          },
          "title": "Findings",
          "type": "array"
        }
      },
      "required": [
        "passed"
      ],
      "title": "TruthAudit",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "1.5",
      "enum": [
        "1.0",
        "1.1",
        "1.2",
        "1.3",
        "1.4",
        "1.5"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "run_id": {
      "pattern": "^cr_[0-9]{8}T[0-9]{6}_[a-z0-9]{6}$",
      "title": "Run Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "source_digests": {
      "$ref": "#/$defs/SourceDigests"
    },
    "deterministic_passed": {
      "title": "Deterministic Passed",
      "type": "boolean"
    },
    "deterministic_findings": {
      "items": {
        "$ref": "#/$defs/AuditFinding"
      },
      "title": "Deterministic Findings",
      "type": "array"
    },
    "truth": {
      "$ref": "#/$defs/TruthAudit"
    },
    "quality": {
      "$ref": "#/$defs/QualityAudit"
    },
    "reselect_required": {
      "default": false,
      "title": "Reselect Required",
      "type": "boolean"
    },
    "selection_issue_codes": {
      "items": {
        "type": "string"
      },
      "title": "Selection Issue Codes",
      "type": "array"
    },
    "revisions": {
      "items": {
        "$ref": "#/$defs/RevisionRecord"
      },
      "maxItems": 2,
      "title": "Revisions",
      "type": "array"
    },
    "disposition": {
      "$ref": "#/$defs/AuditDisposition"
    }
  },
  "required": [
    "run_id",
    "created_at",
    "source_digests",
    "deterministic_passed",
    "truth",
    "quality",
    "disposition"
  ],
  "title": "AuditArtifact",
  "type": "object"
}
