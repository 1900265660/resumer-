{
  "$defs": {
    "ConfirmationStatus": {
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "title": "ConfirmationStatus",
      "type": "string"
    },
    "DiffAction": {
      "enum": [
        "add",
        "replace"
      ],
      "title": "DiffAction",
      "type": "string"
    },
    "FactDiffOperation": {
      "additionalProperties": false,
      "properties": {
        "operation_id": {
          "pattern": "^FD-[0-9]{3}$",
          "title": "Operation Id",
          "type": "string"
        },
        "action": {
          "$ref": "#/$defs/DiffAction"
        },
        "experience_id": {
          "pattern": "^EXP-[A-Z]+-[0-9]{3}$",
          "title": "Experience Id",
          "type": "string"
        },
        "target_fact_id": {
          "anyOf": [
            {
              "pattern": "^FACT-[A-Z]+-[0-9]{3}-[0-9]{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Fact Id"
        },
        "proposed_fact_id": {
          "anyOf": [
            {
              "pattern": "^FACT-[A-Z]+-[0-9]{3}-[0-9]{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Proposed Fact Id"
        },
        "old_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Old Value"
        },
        "new_value": {
          "minLength": 1,
          "title": "New Value",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/FactProvenance"
        },
        "estimate_basis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimate Basis"
        },
        "confirmation_status": {
          "$ref": "#/$defs/ConfirmationStatus",
          "default": "pending"
        },
        "confirmed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confirmed At"
        }
      },
      "required": [
        "operation_id",
        "action",
        "experience_id",
        "new_value",
        "provenance"
      ],
      "title": "FactDiffOperation",
      "type": "object"
    },
    "FactGapQuestion": {
      "additionalProperties": false,
      "properties": {
        "question_id": {
          "pattern": "^Q-[0-9]{3}$",
          "title": "Question Id",
          "type": "string"
        },
        "requirement_ids": {
          "items": {
            "pattern": "^REQ-[0-9]{3}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Requirement Ids",
          "type": "array"
        },
        "prompt": {
          "minLength": 1,
          "title": "Prompt",
          "type": "string"
        },
        "options": {
          "items": {
            "$ref": "#/$defs/FactQuestionOption"
          },
          "maxItems": 4,
          "minItems": 2,
          "title": "Options",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/QuestionStatus",
          "default": "unanswered"
        },
        "selected_option_id": {
          "anyOf": [
            {
              "pattern": "^[A-Z]$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Selected Option Id"
        },
        "answer_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Answer Text"
        }
      },
      "required": [
        "question_id",
        "requirement_ids",
        "prompt",
        "options"
      ],
      "title": "FactGapQuestion",
      "type": "object"
    },
    "FactProvenance": {
      "enum": [
        "observed",
        "accepted_estimate"
      ],
      "title": "FactProvenance",
      "type": "string"
    },
    "FactQuestionOption": {
      "additionalProperties": false,
      "properties": {
        "option_id": {
          "pattern": "^[A-Z]$",
          "title": "Option Id",
          "type": "string"
        },
        "label": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "option_id",
        "label",
        "description"
      ],
      "title": "FactQuestionOption",
      "type": "object"
    },
    "QuestionStatus": {
      "enum": [
        "unanswered",
        "answered",
        "skipped"
      ],
      "title": "QuestionStatus",
      "type": "string"
    },
    "SourceDigests": {
      "additionalProperties": false,
      "properties": {
        "jd_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Jd Sha256",
          "type": "string"
        },
        "fact_snapshot_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Fact Snapshot Sha256",
          "type": "string"
        },
        "preferences_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Preferences Sha256",
          "type": "string"
        },
        "reference_cards_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference Cards Sha256"
        }
      },
      "required": [
        "jd_sha256",
        "fact_snapshot_sha256",
        "preferences_sha256"
      ],
      "title": "SourceDigests",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "1.5",
      "enum": [
        "1.0",
        "1.1",
        "1.2",
        "1.3",
        "1.4",
        "1.5"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "run_id": {
      "pattern": "^cr_[0-9]{8}T[0-9]{6}_[a-z0-9]{6}$",
      "title": "Run Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "source_digests": {
      "$ref": "#/$defs/SourceDigests"
    },
    "source_fact_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Fact Sha256",
      "type": "string"
    },
    "result_fact_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Result Fact Sha256"
    },
    "confirmation_status": {
      "$ref": "#/$defs/ConfirmationStatus",
      "default": "pending"
    },
    "questions": {
      "items": {
        "$ref": "#/$defs/FactGapQuestion"
      },
      "maxItems": 5,
      "title": "Questions",
      "type": "array"
    },
    "operations": {
      "items": {
        "$ref": "#/$defs/FactDiffOperation"
      },
      "title": "Operations",
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "created_at",
    "source_digests",
    "source_fact_sha256"
  ],
  "title": "FactDiffArtifact",
  "type": "object"
}
