{
  "$defs": {
    "DraftAgent": {
      "enum": [
        "writer",
        "asu_writer"
      ],
      "title": "DraftAgent",
      "type": "string"
    },
    "DraftExperienceQualityReview": {
      "additionalProperties": false,
      "properties": {
        "experience_id": {
          "pattern": "^EXP-[A-Z]+-[0-9]{3}$",
          "title": "Experience Id",
          "type": "string"
        },
        "bullet_count": {
          "maximum": 14,
          "minimum": 1,
          "title": "Bullet Count",
          "type": "integer"
        },
        "score": {
          "maximum": 10,
          "minimum": 0,
          "title": "Score",
          "type": "number"
        },
        "developed_elements": {
          "items": {
            "enum": [
              "context_or_object",
              "personal_action",
              "method_or_decision",
              "deliverable_or_complexity",
              "credible_result",
              "personal_boundary"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Developed Elements",
          "type": "array"
        },
        "result_status": {
          "$ref": "#/$defs/DraftResultStatus"
        },
        "result_rationale": {
          "minLength": 1,
          "title": "Result Rationale",
          "type": "string"
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "defects": {
          "items": {
            "type": "string"
          },
          "title": "Defects",
          "type": "array"
        },
        "revision_instructions": {
          "items": {
            "type": "string"
          },
          "title": "Revision Instructions",
          "type": "array"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        }
      },
      "required": [
        "experience_id",
        "bullet_count",
        "score",
        "developed_elements",
        "result_status",
        "result_rationale",
        "evidence",
        "passed"
      ],
      "title": "DraftExperienceQualityReview",
      "type": "object"
    },
    "DraftLaneQualityReview": {
      "additionalProperties": false,
      "properties": {
        "agent": {
          "$ref": "#/$defs/DraftAgent"
        },
        "draft_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Draft Sha256",
          "type": "string"
        },
        "experience_development": {
          "$ref": "#/$defs/DraftQualityDimension"
        },
        "result_backing": {
          "$ref": "#/$defs/DraftQualityDimension"
        },
        "information_density": {
          "$ref": "#/$defs/DraftQualityDimension"
        },
        "scan_naturalness": {
          "$ref": "#/$defs/DraftQualityDimension"
        },
        "experience_reviews": {
          "items": {
            "$ref": "#/$defs/DraftExperienceQualityReview"
          },
          "minItems": 1,
          "title": "Experience Reviews",
          "type": "array"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        }
      },
      "required": [
        "agent",
        "draft_sha256",
        "experience_development",
        "result_backing",
        "information_density",
        "scan_naturalness",
        "experience_reviews",
        "passed"
      ],
      "title": "DraftLaneQualityReview",
      "type": "object"
    },
    "DraftQualityDimension": {
      "additionalProperties": false,
      "properties": {
        "score": {
          "maximum": 10,
          "minimum": 0,
          "title": "Score",
          "type": "number"
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "recommendations": {
          "items": {
            "type": "string"
          },
          "title": "Recommendations",
          "type": "array"
        }
      },
      "required": [
        "score",
        "evidence"
      ],
      "title": "DraftQualityDimension",
      "type": "object"
    },
    "DraftResultStatus": {
      "enum": [
        "quantified",
        "qualitative",
        "no_confirmed_result",
        "missing_supported_result"
      ],
      "title": "DraftResultStatus",
      "type": "string"
    },
    "ExecutionMode": {
      "enum": [
        "blind_dual",
        "single_agent_degraded"
      ],
      "title": "ExecutionMode",
      "type": "string"
    },
    "SourceDigests": {
      "additionalProperties": false,
      "properties": {
        "jd_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Jd Sha256",
          "type": "string"
        },
        "fact_snapshot_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Fact Snapshot Sha256",
          "type": "string"
        },
        "preferences_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Preferences Sha256",
          "type": "string"
        },
        "reference_cards_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference Cards Sha256"
        }
      },
      "required": [
        "jd_sha256",
        "fact_snapshot_sha256",
        "preferences_sha256"
      ],
      "title": "SourceDigests",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "1.5",
      "enum": [
        "1.0",
        "1.1",
        "1.2",
        "1.3",
        "1.4",
        "1.5"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "run_id": {
      "pattern": "^cr_[0-9]{8}T[0-9]{6}_[a-z0-9]{6}$",
      "title": "Run Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "source_digests": {
      "$ref": "#/$defs/SourceDigests"
    },
    "revision_round": {
      "maximum": 2,
      "minimum": 0,
      "title": "Revision Round",
      "type": "integer"
    },
    "execution_mode": {
      "$ref": "#/$defs/ExecutionMode"
    },
    "lane_reviews": {
      "items": {
        "$ref": "#/$defs/DraftLaneQualityReview"
      },
      "maxItems": 2,
      "minItems": 1,
      "title": "Lane Reviews",
      "type": "array"
    },
    "passed": {
      "title": "Passed",
      "type": "boolean"
    }
  },
  "required": [
    "run_id",
    "created_at",
    "source_digests",
    "revision_round",
    "execution_mode",
    "lane_reviews",
    "passed"
  ],
  "title": "DraftQualityAuditArtifact",
  "type": "object"
}
