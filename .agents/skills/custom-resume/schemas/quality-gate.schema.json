{
  "$defs": {
    "AuditFinding": {
      "additionalProperties": false,
      "properties": {
        "error_code": {
          "pattern": "^[A-Z][A-Z0-9_]+$",
          "title": "Error Code",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "artifact": {
          "minLength": 1,
          "title": "Artifact",
          "type": "string"
        },
        "field_path": {
          "minLength": 1,
          "title": "Field Path",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "error_code",
        "severity",
        "artifact",
        "field_path",
        "message"
      ],
      "title": "AuditFinding",
      "type": "object"
    },
    "ContentMetrics": {
      "additionalProperties": false,
      "properties": {
        "chinese_character_count": {
          "minimum": 0,
          "title": "Chinese Character Count",
          "type": "integer"
        },
        "experience_bullet_count": {
          "minimum": 0,
          "title": "Experience Bullet Count",
          "type": "integer"
        },
        "total_bullet_count": {
          "minimum": 0,
          "title": "Total Bullet Count",
          "type": "integer"
        }
      },
      "required": [
        "chinese_character_count",
        "experience_bullet_count",
        "total_bullet_count"
      ],
      "title": "ContentMetrics",
      "type": "object"
    },
    "ExperienceQualityGateResult": {
      "additionalProperties": false,
      "properties": {
        "experience_id": {
          "pattern": "^EXP-[A-Z]+-[0-9]{3}$",
          "title": "Experience Id",
          "type": "string"
        },
        "bullet_count": {
          "minimum": 0,
          "title": "Bullet Count",
          "type": "integer"
        },
        "intent_ids": {
          "items": {
            "pattern": "^INT-[0-9]{3}$",
            "type": "string"
          },
          "title": "Intent Ids",
          "type": "array"
        },
        "covered_elements": {
          "items": {
            "enum": [
              "context",
              "action",
              "method",
              "challenge",
              "result"
            ],
            "type": "string"
          },
          "title": "Covered Elements",
          "type": "array"
        },
        "max_source_similarity": {
          "default": 0,
          "maximum": 1,
          "minimum": 0,
          "title": "Max Source Similarity",
          "type": "number"
        },
        "failure_codes": {
          "items": {
            "type": "string"
          },
          "title": "Failure Codes",
          "type": "array"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        }
      },
      "required": [
        "experience_id",
        "bullet_count",
        "passed"
      ],
      "title": "ExperienceQualityGateResult",
      "type": "object"
    },
    "Severity": {
      "enum": [
        "hard",
        "warning"
      ],
      "title": "Severity",
      "type": "string"
    },
    "SourceDigests": {
      "additionalProperties": false,
      "properties": {
        "jd_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Jd Sha256",
          "type": "string"
        },
        "fact_snapshot_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Fact Snapshot Sha256",
          "type": "string"
        },
        "preferences_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Preferences Sha256",
          "type": "string"
        },
        "reference_cards_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference Cards Sha256"
        }
      },
      "required": [
        "jd_sha256",
        "fact_snapshot_sha256",
        "preferences_sha256"
      ],
      "title": "SourceDigests",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "1.5",
      "enum": [
        "1.0",
        "1.1",
        "1.2",
        "1.3",
        "1.4",
        "1.5"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "run_id": {
      "pattern": "^cr_[0-9]{8}T[0-9]{6}_[a-z0-9]{6}$",
      "title": "Run Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "source_digests": {
      "$ref": "#/$defs/SourceDigests"
    },
    "candidate_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Candidate Sha256"
    },
    "story_plan_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Story Plan Sha256"
    },
    "passed": {
      "title": "Passed",
      "type": "boolean"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/AuditFinding"
      },
      "title": "Findings",
      "type": "array"
    },
    "hard_failures": {
      "items": {
        "type": "string"
      },
      "title": "Hard Failures",
      "type": "array"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    },
    "per_experience_results": {
      "items": {
        "$ref": "#/$defs/ExperienceQualityGateResult"
      },
      "title": "Per Experience Results",
      "type": "array"
    },
    "metrics": {
      "$ref": "#/$defs/ContentMetrics"
    }
  },
  "required": [
    "run_id",
    "created_at",
    "source_digests",
    "passed",
    "metrics"
  ],
  "title": "DeterministicValidationArtifact",
  "type": "object"
}
