{
  "$defs": {
    "RunStatus": {
      "enum": [
        "approved",
        "superseded",
        "user_rejected",
        "schema_invalid",
        "revoked"
      ],
      "title": "RunStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.5",
      "default": "1.5",
      "title": "Schema Version",
      "type": "string"
    },
    "run_id": {
      "pattern": "^cr_[0-9]{8}T[0-9]{6}_[a-z0-9]{6}$",
      "title": "Run Id",
      "type": "string"
    },
    "content_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Content Sha256"
    },
    "status": {
      "$ref": "#/$defs/RunStatus"
    },
    "reason_code": {
      "pattern": "^[A-Z][A-Z0-9_]+$",
      "title": "Reason Code",
      "type": "string"
    },
    "recorded_at": {
      "format": "date-time",
      "title": "Recorded At",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "status",
    "reason_code",
    "recorded_at"
  ],
  "title": "RunStatusRecord",
  "type": "object"
}
