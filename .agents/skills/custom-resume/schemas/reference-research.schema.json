{
  "$defs": {
    "ReferenceResearchMode": {
      "enum": [
        "local",
        "supplemented",
        "degraded"
      ],
      "title": "ReferenceResearchMode",
      "type": "string"
    },
    "ReferenceSource": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "url": {
          "pattern": "^https://[^\\s]+$",
          "title": "Url",
          "type": "string"
        },
        "retrieved_at": {
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        },
        "source_type": {
          "$ref": "#/$defs/ReferenceSourceType",
          "default": "open_source_method"
        },
        "qualified": {
          "default": false,
          "title": "Qualified",
          "type": "boolean"
        }
      },
      "required": [
        "title",
        "url",
        "retrieved_at"
      ],
      "title": "ReferenceSource",
      "type": "object"
    },
    "ReferenceSourceType": {
      "enum": [
        "resume_sample",
        "official_role",
        "hiring_guide",
        "open_source_method"
      ],
      "title": "ReferenceSourceType",
      "type": "string"
    },
    "SourceDigests": {
      "additionalProperties": false,
      "properties": {
        "jd_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Jd Sha256",
          "type": "string"
        },
        "fact_snapshot_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Fact Snapshot Sha256",
          "type": "string"
        },
        "preferences_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Preferences Sha256",
          "type": "string"
        },
        "reference_cards_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference Cards Sha256"
        }
      },
      "required": [
        "jd_sha256",
        "fact_snapshot_sha256",
        "preferences_sha256"
      ],
      "title": "SourceDigests",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "1.5",
      "enum": [
        "1.0",
        "1.1",
        "1.2",
        "1.3",
        "1.4",
        "1.5"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "run_id": {
      "pattern": "^cr_[0-9]{8}T[0-9]{6}_[a-z0-9]{6}$",
      "title": "Run Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "source_digests": {
      "$ref": "#/$defs/SourceDigests"
    },
    "mode": {
      "$ref": "#/$defs/ReferenceResearchMode"
    },
    "local_card_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Local Card Sha256",
      "type": "string"
    },
    "missing_topics": {
      "items": {
        "type": "string"
      },
      "title": "Missing Topics",
      "type": "array"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/ReferenceSource"
      },
      "title": "Sources",
      "type": "array"
    },
    "sanitized_method_cards": {
      "items": {
        "type": "string"
      },
      "title": "Sanitized Method Cards",
      "type": "array"
    },
    "selection_rules": {
      "items": {
        "type": "string"
      },
      "title": "Selection Rules",
      "type": "array"
    },
    "qualified": {
      "default": false,
      "title": "Qualified",
      "type": "boolean"
    },
    "degradation_approved_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Degradation Approved At"
    },
    "degradation_approval_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Degradation Approval Reason"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    }
  },
  "required": [
    "run_id",
    "created_at",
    "source_digests",
    "mode",
    "local_card_sha256"
  ],
  "title": "ReferenceResearchArtifact",
  "type": "object"
}
