{
  "$defs": {
    "HrDecisionDimension": {
      "additionalProperties": false,
      "properties": {
        "score": {
          "maximum": 10,
          "minimum": 0,
          "title": "Score",
          "type": "number"
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "evidence_bullet_ids": {
          "items": {
            "pattern": "^(WRITER|ASU|FUSION)-[0-9]{3}$",
            "type": "string"
          },
          "title": "Evidence Bullet Ids",
          "type": "array"
        },
        "recommendations": {
          "items": {
            "type": "string"
          },
          "title": "Recommendations",
          "type": "array"
        }
      },
      "required": [
        "score",
        "evidence"
      ],
      "title": "HrDecisionDimension",
      "type": "object"
    },
    "HrExperienceReview": {
      "additionalProperties": false,
      "properties": {
        "experience_id": {
          "pattern": "^EXP-[A-Z]+-[0-9]{3}$",
          "title": "Experience Id",
          "type": "string"
        },
        "ten_second_impression": {
          "minLength": 1,
          "title": "Ten Second Impression",
          "type": "string"
        },
        "effective_requirement_ids": {
          "items": {
            "pattern": "^REQ-[0-9]{3}$",
            "type": "string"
          },
          "title": "Effective Requirement Ids",
          "type": "array"
        },
        "evidence_bullet_ids": {
          "items": {
            "pattern": "^(WRITER|ASU|FUSION)-[0-9]{3}$",
            "type": "string"
          },
          "title": "Evidence Bullet Ids",
          "type": "array"
        },
        "strengths": {
          "items": {
            "type": "string"
          },
          "title": "Strengths",
          "type": "array"
        },
        "defects": {
          "items": {
            "type": "string"
          },
          "title": "Defects",
          "type": "array"
        },
        "omitted_fact_ids": {
          "items": {
            "pattern": "^FACT-[A-Z]+-[0-9]{3}-[0-9]{2}$",
            "type": "string"
          },
          "title": "Omitted Fact Ids",
          "type": "array"
        },
        "uncited_fact_assessments": {
          "items": {
            "$ref": "#/$defs/HrUncitedFactAssessment"
          },
          "title": "Uncited Fact Assessments",
          "type": "array"
        },
        "severity_score": {
          "maximum": 10,
          "minimum": 0,
          "title": "Severity Score",
          "type": "number"
        },
        "interview_impact": {
          "$ref": "#/$defs/InterviewImpact"
        },
        "recommended_bullet_count": {
          "minimum": 1,
          "title": "Recommended Bullet Count",
          "type": "integer"
        },
        "revision_instructions": {
          "items": {
            "type": "string"
          },
          "title": "Revision Instructions",
          "type": "array"
        },
        "missing_fact_questions": {
          "items": {
            "type": "string"
          },
          "title": "Missing Fact Questions",
          "type": "array"
        }
      },
      "required": [
        "experience_id",
        "ten_second_impression",
        "severity_score",
        "interview_impact",
        "recommended_bullet_count"
      ],
      "title": "HrExperienceReview",
      "type": "object"
    },
    "HrRecommendation": {
      "enum": [
        "strong_push",
        "push",
        "hesitate",
        "reject"
      ],
      "title": "HrRecommendation",
      "type": "string"
    },
    "HrReviewDisposition": {
      "enum": [
        "passed",
        "revise",
        "needs_input",
        "reselect",
        "needs_review"
      ],
      "title": "HrReviewDisposition",
      "type": "string"
    },
    "HrUncitedFactAssessment": {
      "additionalProperties": false,
      "properties": {
        "fact_id": {
          "pattern": "^FACT-[A-Z]+-[0-9]{3}-[0-9]{2}$",
          "title": "Fact Id",
          "type": "string"
        },
        "disposition": {
          "$ref": "#/$defs/UncitedFactDisposition"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "fact_id",
        "disposition",
        "rationale"
      ],
      "title": "HrUncitedFactAssessment",
      "type": "object"
    },
    "InterviewImpact": {
      "enum": [
        "none",
        "minor",
        "material",
        "blocking"
      ],
      "title": "InterviewImpact",
      "type": "string"
    },
    "SourceDigests": {
      "additionalProperties": false,
      "properties": {
        "jd_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Jd Sha256",
          "type": "string"
        },
        "fact_snapshot_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Fact Snapshot Sha256",
          "type": "string"
        },
        "preferences_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Preferences Sha256",
          "type": "string"
        },
        "reference_cards_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference Cards Sha256"
        }
      },
      "required": [
        "jd_sha256",
        "fact_snapshot_sha256",
        "preferences_sha256"
      ],
      "title": "SourceDigests",
      "type": "object"
    },
    "UncitedFactDisposition": {
      "enum": [
        "irrelevant",
        "redundant",
        "should_include"
      ],
      "title": "UncitedFactDisposition",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "1.5",
      "enum": [
        "1.0",
        "1.1",
        "1.2",
        "1.3",
        "1.4",
        "1.5"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "run_id": {
      "pattern": "^cr_[0-9]{8}T[0-9]{6}_[a-z0-9]{6}$",
      "title": "Run Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "source_digests": {
      "$ref": "#/$defs/SourceDigests"
    },
    "revision_round": {
      "maximum": 2,
      "minimum": 0,
      "title": "Revision Round",
      "type": "integer"
    },
    "recommendation": {
      "$ref": "#/$defs/HrRecommendation"
    },
    "overall_score": {
      "maximum": 10,
      "minimum": 0,
      "title": "Overall Score",
      "type": "number"
    },
    "role_fit": {
      "$ref": "#/$defs/HrDecisionDimension"
    },
    "narrative_completeness": {
      "$ref": "#/$defs/HrDecisionDimension"
    },
    "evidence_specificity": {
      "$ref": "#/$defs/HrDecisionDimension"
    },
    "decision_readiness": {
      "$ref": "#/$defs/HrDecisionDimension"
    },
    "credibility": {
      "$ref": "#/$defs/HrDecisionDimension"
    },
    "content_fullness": {
      "anyOf": [
        {
          "$ref": "#/$defs/HrDecisionDimension"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "experience_reviews": {
      "items": {
        "$ref": "#/$defs/HrExperienceReview"
      },
      "minItems": 1,
      "title": "Experience Reviews",
      "type": "array"
    },
    "issue_codes": {
      "items": {
        "type": "string"
      },
      "title": "Issue Codes",
      "type": "array"
    },
    "existing_fact_revision_sufficient": {
      "title": "Existing Fact Revision Sufficient",
      "type": "boolean"
    },
    "fact_questions_required": {
      "title": "Fact Questions Required",
      "type": "boolean"
    },
    "reselect_required": {
      "title": "Reselect Required",
      "type": "boolean"
    },
    "passed": {
      "title": "Passed",
      "type": "boolean"
    },
    "disposition": {
      "$ref": "#/$defs/HrReviewDisposition"
    }
  },
  "required": [
    "run_id",
    "created_at",
    "source_digests",
    "revision_round",
    "recommendation",
    "overall_score",
    "role_fit",
    "narrative_completeness",
    "evidence_specificity",
    "decision_readiness",
    "credibility",
    "experience_reviews",
    "existing_fact_revision_sufficient",
    "fact_questions_required",
    "reselect_required",
    "passed",
    "disposition"
  ],
  "title": "HrReviewArtifact",
  "type": "object"
}
