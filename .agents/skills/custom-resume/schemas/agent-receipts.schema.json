{
  "$defs": {
    "AgentInvocationReceipt": {
      "additionalProperties": false,
      "properties": {
        "stage": {
          "$ref": "#/$defs/AgentStage"
        },
        "role": {
          "$ref": "#/$defs/AgentRole"
        },
        "invocation_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Invocation Id",
          "type": "string"
        },
        "model": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "reasoning_effort": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Reasoning Effort",
          "type": "string"
        },
        "prompt_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Prompt Sha256",
          "type": "string"
        },
        "input_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Sha256",
          "type": "string"
        },
        "output_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Output Sha256",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "stage",
        "role",
        "invocation_id",
        "model",
        "reasoning_effort",
        "prompt_sha256",
        "input_sha256",
        "output_sha256",
        "created_at"
      ],
      "title": "AgentInvocationReceipt",
      "type": "object"
    },
    "AgentRole": {
      "enum": [
        "coordinator",
        "writer",
        "asu_writer",
        "auditor",
        "hr_reviewer"
      ],
      "title": "AgentRole",
      "type": "string"
    },
    "AgentStage": {
      "enum": [
        "reference_research",
        "jd_analysis",
        "capability_transfer",
        "experience_selection",
        "selection_audit",
        "story_plan",
        "writer",
        "asu_writer",
        "draft_audit",
        "fusion",
        "post_fusion_audit",
        "hr_review"
      ],
      "title": "AgentStage",
      "type": "string"
    },
    "SourceDigests": {
      "additionalProperties": false,
      "properties": {
        "jd_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Jd Sha256",
          "type": "string"
        },
        "fact_snapshot_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Fact Snapshot Sha256",
          "type": "string"
        },
        "preferences_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Preferences Sha256",
          "type": "string"
        },
        "reference_cards_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference Cards Sha256"
        }
      },
      "required": [
        "jd_sha256",
        "fact_snapshot_sha256",
        "preferences_sha256"
      ],
      "title": "SourceDigests",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "1.5",
      "enum": [
        "1.0",
        "1.1",
        "1.2",
        "1.3",
        "1.4",
        "1.5"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "run_id": {
      "pattern": "^cr_[0-9]{8}T[0-9]{6}_[a-z0-9]{6}$",
      "title": "Run Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "source_digests": {
      "$ref": "#/$defs/SourceDigests"
    },
    "receipts": {
      "items": {
        "$ref": "#/$defs/AgentInvocationReceipt"
      },
      "minItems": 1,
      "title": "Receipts",
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "created_at",
    "source_digests",
    "receipts"
  ],
  "title": "AgentReceiptBundleArtifact",
  "type": "object"
}
