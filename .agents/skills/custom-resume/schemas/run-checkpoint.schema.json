{
  "$defs": {
    "CapabilityCategory": {
      "enum": [
        "planning_delivery",
        "stakeholder_collaboration",
        "quality_risk",
        "user_research",
        "data_analysis",
        "content_communication",
        "product_technology",
        "operations_business_domain"
      ],
      "title": "CapabilityCategory",
      "type": "string"
    },
    "CapabilityCategoryScan": {
      "additionalProperties": false,
      "properties": {
        "experience_id": {
          "pattern": "^EXP-[A-Z]+-[0-9]{3}$",
          "title": "Experience Id",
          "type": "string"
        },
        "category": {
          "$ref": "#/$defs/CapabilityCategory"
        },
        "status": {
          "$ref": "#/$defs/CapabilityStatus"
        },
        "transfer_ids": {
          "items": {
            "pattern": "^TR-[0-9]{3}$",
            "type": "string"
          },
          "title": "Transfer Ids",
          "type": "array"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "experience_id",
        "category",
        "status",
        "rationale"
      ],
      "title": "CapabilityCategoryScan",
      "type": "object"
    },
    "CapabilityStatus": {
      "enum": [
        "supported",
        "candidate",
        "none"
      ],
      "title": "CapabilityStatus",
      "type": "string"
    },
    "CapabilityTransfer": {
      "additionalProperties": false,
      "properties": {
        "transfer_id": {
          "pattern": "^TR-[0-9]{3}$",
          "title": "Transfer Id",
          "type": "string"
        },
        "experience_id": {
          "pattern": "^EXP-[A-Z]+-[0-9]{3}$",
          "title": "Experience Id",
          "type": "string"
        },
        "category": {
          "$ref": "#/$defs/CapabilityCategory"
        },
        "fact_ids": {
          "items": {
            "pattern": "^FACT-[A-Z]+-[0-9]{3}-[0-9]{2}$",
            "type": "string"
          },
          "title": "Fact Ids",
          "type": "array"
        },
        "source_action": {
          "minLength": 1,
          "title": "Source Action",
          "type": "string"
        },
        "target_capability": {
          "minLength": 1,
          "title": "Target Capability",
          "type": "string"
        },
        "requirement_ids": {
          "items": {
            "pattern": "^REQ-[0-9]{3}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Requirement Ids",
          "type": "array"
        },
        "distance": {
          "$ref": "#/$defs/TransferDistance"
        },
        "confidence": {
          "$ref": "#/$defs/TransferConfidence"
        },
        "credit_multiplier": {
          "maximum": 1,
          "minimum": 0,
          "title": "Credit Multiplier",
          "type": "number"
        },
        "writable_scope": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Writable Scope"
        },
        "candidate_question_id": {
          "anyOf": [
            {
              "pattern": "^Q-[0-9]{3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Candidate Question Id"
        }
      },
      "required": [
        "transfer_id",
        "experience_id",
        "category",
        "source_action",
        "target_capability",
        "requirement_ids",
        "distance",
        "confidence",
        "credit_multiplier"
      ],
      "title": "CapabilityTransfer",
      "type": "object"
    },
    "CapabilityTransferMapArtifact": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "default": "1.3",
          "enum": [
            "1.0",
            "1.1",
            "1.2",
            "1.3"
          ],
          "title": "Schema Version",
          "type": "string"
        },
        "run_id": {
          "pattern": "^cr_[0-9]{8}T[0-9]{6}_[a-z0-9]{6}$",
          "title": "Run Id",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "source_digests": {
          "$ref": "#/$defs/SourceDigests"
        },
        "experience_ids": {
          "items": {
            "pattern": "^EXP-[A-Z]+-[0-9]{3}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Experience Ids",
          "type": "array"
        },
        "transfers": {
          "items": {
            "$ref": "#/$defs/CapabilityTransfer"
          },
          "title": "Transfers",
          "type": "array"
        },
        "scans": {
          "items": {
            "$ref": "#/$defs/CapabilityCategoryScan"
          },
          "minItems": 1,
          "title": "Scans",
          "type": "array"
        }
      },
      "required": [
        "run_id",
        "created_at",
        "source_digests",
        "experience_ids",
        "scans"
      ],
      "title": "CapabilityTransferMapArtifact",
      "type": "object"
    },
    "ConfirmationStatus": {
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "title": "ConfirmationStatus",
      "type": "string"
    },
    "ContentState": {
      "enum": [
        "not_started",
        "analyzing",
        "needs_input",
        "awaiting_reference_approval",
        "awaiting_selection_approval",
        "drafting",
        "auditing",
        "hr_reviewing",
        "needs_content_review",
        "approved",
        "failed",
        "stale"
      ],
      "title": "ContentState",
      "type": "string"
    },
    "CoverageLevel": {
      "enum": [
        "direct",
        "composite",
        "accepted_estimate",
        "candidate",
        "unsupported"
      ],
      "title": "CoverageLevel",
      "type": "string"
    },
    "DiffAction": {
      "enum": [
        "add",
        "replace"
      ],
      "title": "DiffAction",
      "type": "string"
    },
    "EvidenceMapArtifact": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "default": "1.3",
          "enum": [
            "1.0",
            "1.1",
            "1.2",
            "1.3"
          ],
          "title": "Schema Version",
          "type": "string"
        },
        "run_id": {
          "pattern": "^cr_[0-9]{8}T[0-9]{6}_[a-z0-9]{6}$",
          "title": "Run Id",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "source_digests": {
          "$ref": "#/$defs/SourceDigests"
        },
        "mappings": {
          "items": {
            "$ref": "#/$defs/EvidenceMapping"
          },
          "minItems": 1,
          "title": "Mappings",
          "type": "array"
        },
        "selection_approved": {
          "default": false,
          "title": "Selection Approved",
          "type": "boolean"
        },
        "approved_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approved At"
        }
      },
      "required": [
        "run_id",
        "created_at",
        "source_digests",
        "mappings"
      ],
      "title": "EvidenceMapArtifact",
      "type": "object"
    },
    "EvidenceMapping": {
      "additionalProperties": false,
      "properties": {
        "requirement_id": {
          "pattern": "^REQ-[0-9]{3}$",
          "title": "Requirement Id",
          "type": "string"
        },
        "coverage": {
          "$ref": "#/$defs/CoverageLevel"
        },
        "fact_ids": {
          "items": {
            "pattern": "^FACT-[A-Z]+-[0-9]{3}-[0-9]{2}$",
            "type": "string"
          },
          "title": "Fact Ids",
          "type": "array"
        },
        "selected": {
          "default": false,
          "title": "Selected",
          "type": "boolean"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "gap_summary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gap Summary"
        }
      },
      "required": [
        "requirement_id",
        "coverage",
        "rationale"
      ],
      "title": "EvidenceMapping",
      "type": "object"
    },
    "ExecutionMode": {
      "enum": [
        "blind_dual",
        "single_agent_degraded"
      ],
      "title": "ExecutionMode",
      "type": "string"
    },
    "ExperienceCandidateScore": {
      "additionalProperties": false,
      "properties": {
        "experience_id": {
          "pattern": "^EXP-[A-Z]+-[0-9]{3}$",
          "title": "Experience Id",
          "type": "string"
        },
        "fact_ids": {
          "items": {
            "pattern": "^FACT-[A-Z]+-[0-9]{3}-[0-9]{2}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Fact Ids",
          "type": "array"
        },
        "responsibility_score": {
          "maximum": 30,
          "minimum": 0,
          "title": "Responsibility Score",
          "type": "integer"
        },
        "process_delivery_score": {
          "maximum": 20,
          "minimum": 0,
          "title": "Process Delivery Score",
          "type": "integer"
        },
        "result_score": {
          "maximum": 15,
          "minimum": 0,
          "title": "Result Score",
          "type": "integer"
        },
        "domain_score": {
          "maximum": 10,
          "minimum": 0,
          "title": "Domain Score",
          "type": "integer"
        },
        "incremental_coverage_score": {
          "maximum": 15,
          "minimum": 0,
          "title": "Incremental Coverage Score",
          "type": "integer"
        },
        "evidence_strength_score": {
          "maximum": 10,
          "minimum": 0,
          "title": "Evidence Strength Score",
          "type": "integer"
        },
        "job_task_evidence": {
          "$ref": "#/$defs/JobTaskEvidenceLevel"
        },
        "total_score": {
          "maximum": 100,
          "minimum": 0,
          "title": "Total Score",
          "type": "integer"
        },
        "tier": {
          "$ref": "#/$defs/ExperienceTier"
        },
        "matched_requirement_ids": {
          "items": {
            "pattern": "^REQ-[0-9]{3}$",
            "type": "string"
          },
          "title": "Matched Requirement Ids",
          "type": "array"
        },
        "incremental_requirement_ids": {
          "items": {
            "pattern": "^REQ-[0-9]{3}$",
            "type": "string"
          },
          "title": "Incremental Requirement Ids",
          "type": "array"
        },
        "selected": {
          "default": false,
          "title": "Selected",
          "type": "boolean"
        },
        "proposed_bullet_count": {
          "default": 0,
          "maximum": 14,
          "minimum": 0,
          "title": "Proposed Bullet Count",
          "type": "integer"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "omission_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Omission Reason"
        },
        "user_override_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "User Override Reason"
        },
        "capability_transfer_ids": {
          "items": {
            "pattern": "^TR-[0-9]{3}$",
            "type": "string"
          },
          "title": "Capability Transfer Ids",
          "type": "array"
        },
        "transfer_score_credits": {
          "items": {
            "$ref": "#/$defs/TransferScoreCredit"
          },
          "title": "Transfer Score Credits",
          "type": "array"
        },
        "portfolio_value_score": {
          "anyOf": [
            {
              "$ref": "#/$defs/PortfolioValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "similarity_group": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Similarity Group"
        },
        "is_personal_development": {
          "default": false,
          "title": "Is Personal Development",
          "type": "boolean"
        }
      },
      "required": [
        "experience_id",
        "fact_ids",
        "responsibility_score",
        "process_delivery_score",
        "result_score",
        "domain_score",
        "incremental_coverage_score",
        "evidence_strength_score",
        "job_task_evidence",
        "total_score",
        "tier",
        "rationale"
      ],
      "title": "ExperienceCandidateScore",
      "type": "object"
    },
    "ExperienceSelectionArtifact": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "default": "1.3",
          "enum": [
            "1.0",
            "1.1",
            "1.2",
            "1.3"
          ],
          "title": "Schema Version",
          "type": "string"
        },
        "run_id": {
          "pattern": "^cr_[0-9]{8}T[0-9]{6}_[a-z0-9]{6}$",
          "title": "Run Id",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "source_digests": {
          "$ref": "#/$defs/SourceDigests"
        },
        "candidates": {
          "items": {
            "$ref": "#/$defs/ExperienceCandidateScore"
          },
          "minItems": 1,
          "title": "Candidates",
          "type": "array"
        },
        "capability_transfer_map_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Capability Transfer Map Sha256"
        },
        "section_balance_override": {
          "anyOf": [
            {
              "$ref": "#/$defs/SectionBalanceOverride"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "honest_weak_draft": {
          "default": false,
          "title": "Honest Weak Draft",
          "type": "boolean"
        },
        "selection_approved": {
          "default": false,
          "title": "Selection Approved",
          "type": "boolean"
        },
        "approved_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approved At"
        }
      },
      "required": [
        "run_id",
        "created_at",
        "source_digests",
        "candidates"
      ],
      "title": "ExperienceSelectionArtifact",
      "type": "object"
    },
    "ExperienceTier": {
      "enum": [
        "core",
        "auxiliary",
        "excluded"
      ],
      "title": "ExperienceTier",
      "type": "string"
    },
    "FactDiffArtifact": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "default": "1.3",
          "enum": [
            "1.0",
            "1.1",
            "1.2",
            "1.3"
          ],
          "title": "Schema Version",
          "type": "string"
        },
        "run_id": {
          "pattern": "^cr_[0-9]{8}T[0-9]{6}_[a-z0-9]{6}$",
          "title": "Run Id",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "source_digests": {
          "$ref": "#/$defs/SourceDigests"
        },
        "source_fact_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Fact Sha256",
          "type": "string"
        },
        "result_fact_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Result Fact Sha256"
        },
        "confirmation_status": {
          "$ref": "#/$defs/ConfirmationStatus",
          "default": "pending"
        },
        "questions": {
          "items": {
            "$ref": "#/$defs/FactGapQuestion"
          },
          "maxItems": 5,
          "title": "Questions",
          "type": "array"
        },
        "operations": {
          "items": {
            "$ref": "#/$defs/FactDiffOperation"
          },
          "title": "Operations",
          "type": "array"
        }
      },
      "required": [
        "run_id",
        "created_at",
        "source_digests",
        "source_fact_sha256"
      ],
      "title": "FactDiffArtifact",
      "type": "object"
    },
    "FactDiffOperation": {
      "additionalProperties": false,
      "properties": {
        "operation_id": {
          "pattern": "^FD-[0-9]{3}$",
          "title": "Operation Id",
          "type": "string"
        },
        "action": {
          "$ref": "#/$defs/DiffAction"
        },
        "experience_id": {
          "pattern": "^EXP-[A-Z]+-[0-9]{3}$",
          "title": "Experience Id",
          "type": "string"
        },
        "target_fact_id": {
          "anyOf": [
            {
              "pattern": "^FACT-[A-Z]+-[0-9]{3}-[0-9]{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Fact Id"
        },
        "proposed_fact_id": {
          "anyOf": [
            {
              "pattern": "^FACT-[A-Z]+-[0-9]{3}-[0-9]{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Proposed Fact Id"
        },
        "old_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Old Value"
        },
        "new_value": {
          "minLength": 1,
          "title": "New Value",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/FactProvenance"
        },
        "estimate_basis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimate Basis"
        },
        "confirmation_status": {
          "$ref": "#/$defs/ConfirmationStatus",
          "default": "pending"
        },
        "confirmed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confirmed At"
        }
      },
      "required": [
        "operation_id",
        "action",
        "experience_id",
        "new_value",
        "provenance"
      ],
      "title": "FactDiffOperation",
      "type": "object"
    },
    "FactGapQuestion": {
      "additionalProperties": false,
      "properties": {
        "question_id": {
          "pattern": "^Q-[0-9]{3}$",
          "title": "Question Id",
          "type": "string"
        },
        "requirement_ids": {
          "items": {
            "pattern": "^REQ-[0-9]{3}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Requirement Ids",
          "type": "array"
        },
        "prompt": {
          "minLength": 1,
          "title": "Prompt",
          "type": "string"
        },
        "options": {
          "items": {
            "$ref": "#/$defs/FactQuestionOption"
          },
          "maxItems": 4,
          "minItems": 2,
          "title": "Options",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/QuestionStatus",
          "default": "unanswered"
        },
        "selected_option_id": {
          "anyOf": [
            {
              "pattern": "^[A-Z]$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Selected Option Id"
        },
        "answer_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Answer Text"
        }
      },
      "required": [
        "question_id",
        "requirement_ids",
        "prompt",
        "options"
      ],
      "title": "FactGapQuestion",
      "type": "object"
    },
    "FactProvenance": {
      "enum": [
        "observed",
        "accepted_estimate"
      ],
      "title": "FactProvenance",
      "type": "string"
    },
    "FactQuestionOption": {
      "additionalProperties": false,
      "properties": {
        "option_id": {
          "pattern": "^[A-Z]$",
          "title": "Option Id",
          "type": "string"
        },
        "label": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "option_id",
        "label",
        "description"
      ],
      "title": "FactQuestionOption",
      "type": "object"
    },
    "IdealEvidenceItem": {
      "additionalProperties": false,
      "properties": {
        "requirement_id": {
          "pattern": "^REQ-[0-9]{3}$",
          "title": "Requirement Id",
          "type": "string"
        },
        "evidence_description": {
          "minLength": 1,
          "title": "Evidence Description",
          "type": "string"
        },
        "candidate_specific": {
          "const": false,
          "default": false,
          "title": "Candidate Specific",
          "type": "boolean"
        }
      },
      "required": [
        "requirement_id",
        "evidence_description"
      ],
      "title": "IdealEvidenceItem",
      "type": "object"
    },
    "JDAnalysisArtifact": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "default": "1.3",
          "enum": [
            "1.0",
            "1.1",
            "1.2",
            "1.3"
          ],
          "title": "Schema Version",
          "type": "string"
        },
        "run_id": {
          "pattern": "^cr_[0-9]{8}T[0-9]{6}_[a-z0-9]{6}$",
          "title": "Run Id",
