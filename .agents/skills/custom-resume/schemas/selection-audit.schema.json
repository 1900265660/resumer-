{
  "$defs": {
    "SelectionAuditPhase": {
      "enum": [
        "pre_draft",
        "post_fusion"
      ],
      "title": "SelectionAuditPhase",
      "type": "string"
    },
    "SelectionAuditRow": {
      "additionalProperties": false,
      "properties": {
        "experience_id": {
          "pattern": "^EXP-[A-Z]+-[0-9]{3}$",
          "title": "Experience Id",
          "type": "string"
        },
        "verdict": {
          "$ref": "#/$defs/SelectionAuditVerdict"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "experience_id",
        "verdict",
        "rationale"
      ],
      "title": "SelectionAuditRow",
      "type": "object"
    },
    "SelectionAuditVerdict": {
      "enum": [
        "keep",
        "auxiliary",
        "drop",
        "reconsider"
      ],
      "title": "SelectionAuditVerdict",
      "type": "string"
    },
    "SourceDigests": {
      "additionalProperties": false,
      "properties": {
        "jd_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Jd Sha256",
          "type": "string"
        },
        "fact_snapshot_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Fact Snapshot Sha256",
          "type": "string"
        },
        "preferences_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Preferences Sha256",
          "type": "string"
        },
        "reference_cards_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference Cards Sha256"
        }
      },
      "required": [
        "jd_sha256",
        "fact_snapshot_sha256",
        "preferences_sha256"
      ],
      "title": "SourceDigests",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "1.3",
      "enum": [
        "1.0",
        "1.1",
        "1.2",
        "1.3"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "run_id": {
      "pattern": "^cr_[0-9]{8}T[0-9]{6}_[a-z0-9]{6}$",
      "title": "Run Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "source_digests": {
      "$ref": "#/$defs/SourceDigests"
    },
    "phase": {
      "$ref": "#/$defs/SelectionAuditPhase"
    },
    "rows": {
      "items": {
        "$ref": "#/$defs/SelectionAuditRow"
      },
      "minItems": 1,
      "title": "Rows",
      "type": "array"
    },
    "passed": {
      "title": "Passed",
      "type": "boolean"
    },
    "reselect_required": {
      "default": false,
      "title": "Reselect Required",
      "type": "boolean"
    },
    "issue_codes": {
      "items": {
        "type": "string"
      },
      "title": "Issue Codes",
      "type": "array"
    },
    "recommendations": {
      "items": {
        "type": "string"
      },
      "title": "Recommendations",
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "created_at",
    "source_digests",
    "phase",
    "rows",
    "passed"
  ],
  "title": "SelectionAuditArtifact",
  "type": "object"
}
